    /**
     * Проверка транзакции перед отправкой
     */
    async validateTransaction(tx) {
        const { to, value, data } = tx;

        const reputation = await this.evaluateContractReputation(to);
        if (reputation < 50) {
            console.warn(`Адрес ${to} имеет низкую репутацию: ${reputation}`);
            this.activateDefense('suspicious_contract', { address: to });
            return false;
        }

        if (await this.isAddressSuspicious(to)) {
            console.warn(`Адрес ${to} может быть фишинговым`);
            this.activateDefense('possible_phishing', { address: to });
            return false;
        }

        if (data && this.containsReentrancyPattern(data)) {
            console.warn("Обнаружен паттерн reentrancy в данных транзакции");
            this.activateDefense('reentrancy_risk', { tx });
            return false;
        }

        console.log("Транзакция прошла валидацию");
        return true;
    }

    containsReentrancyPattern(data) {
        const reentrancyPatterns = [
            /call\.value\(/i,
            /delegatecall\(/i
        ];

        for (const pattern of reentrancyPatterns) {
            if (pattern.test(data)) return true;
        }
        return false;
    }

    async isAddressSuspicious(address) {
        const knownPhishingAddresses = ['0x123...abc', '0x456...def'];
        return knownPhishingAddresses.includes(address.toLowerCase());
    }

    /**
     * Безопасное хранение приватного ключа
     */
    async storePrivateKey(privateKey) {
        if (!this.biometricAuth.enabled) {
            throw new Error("Биометрическая аутентификация не включена");
        }

        const encryptedKey = await this.encryptData(privateKey);
        localStorage.setItem('encrypted_private_key', encryptedKey);
        console.log("Приватный ключ безопасно сохранен");
    }

    /**
     * Получение приватного ключа
     */
    async retrievePrivateKey() {
        if (!this.biometricAuth.enabled) {
            throw new Error("Биометрическая аутентификация не включена");
        }

        const authSuccess = await this.performBiometricAuth();
        if (!authSuccess) {
            throw new Error("Не удалось пройти биометрическую аутентификацию");
        }

        const encryptedKey = localStorage.getItem('encrypted_private_key');
        if (!encryptedKey) {
            throw new Error("Приватный ключ не найден");
        }

        const privateKey = `decrypted_${encryptedKey}`;
        console.log("Приватный ключ успешно получен");
        return privateKey;
    }

    /**
     * Мониторинг транзакций в мемпуле
     */
    async monitorMempool() {
        console.log("Мониторинг мемпула для обнаружения front-running...");
        const pendingTxs = await this.web3.provider.getBlock('pending');
        const suspiciousTxs = pendingTxs.transactions.filter(tx => 
            tx.to === this.web3.walletAddress && tx.data.includes('swap')
        );

        if (suspiciousTxs.length > 1) {
            console.warn("Обнаружен риск front-running");
            this.activateDefense('front_running_risk', { txs: suspiciousTxs });
        }
    }

    /**
     * Отправка защищенной транзакции
     */
    async sendProtectedTransaction(tx) {
        if (!this.web3.signer) {
            throw new Error("Кошелек не подключен");
        }

        const isValid = await this.validateTransaction(tx);
        if (!isValid) {
            throw new Error("Транзакция не прошла валидацию");
        }

        await this.monitorMempool();
        const signedTx = await this.web3.signer.sendTransaction(tx);
        console.log("Транзакция отправлена:", signedTx.hash);

        const receipt = await signedTx.wait();
        console.log("Транзакция подтверждена:", receipt.transactionHash);
        return receipt;
    }

