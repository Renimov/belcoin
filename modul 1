    /**
     * Оценка репутации смарт-контракта
     */
    async evaluateContractReputation(contractAddress) {
        const sourceInfo = this.getSuspiciousSourceInfo(contractAddress);
        if (sourceInfo) {
            return 100 - sourceInfo.threatScore;
        }

        const isVerified = await this.isContractVerified(contractAddress);
        const reputation = isVerified ? 100 : 50;
        this.trackSuspiciousSource({ source: contractAddress, type: 'contract_access' });
        return reputation;
    }

    async isContractVerified(contractAddress) {
        return true;
