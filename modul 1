    /**
     * Оценка репутации источника
     */
    evaluateSourceReputation(source) {
        const sourceInfo = this.getSuspiciousSourceInfo(source);
        if (!sourceInfo) return 100;

        const reputation = 100 - sourceInfo.threatScore;
        if (reputation < 50) {
            console.warn(`Источник ${source} имеет низкую репутацию: ${reputation}`);
            this.activateDefense('low_reputation_source', { source });
        }

        return reputation;
    }

