    /**
     * Проверка целостности кода и зависимостей
     */
    async verifyCodeIntegrity() {
        const dependencies = [
            { name: 'lib1', hash: 'sha256:abc123' },
            { name: 'lib2', hash: 'sha256:def456' }
        ];

        for (const dep of dependencies) {
            const computedHash = this.computeHash(dep.name);
            if (computedHash !== dep.hash) {
                console.error(`Нарушение целостности зависимости: ${dep.name}`);
                this.activateDefense('code_integrity_violation', { dependency: dep });
                return false;
            }
        }

        console.log("Целостность кода и зависимостей подтверждена");
        return true;
    }

    computeHash(data) {
        return `sha256:${data}`;
    }

