    /**
     * Инициализация постквантового шифрования
     */
    initPostQuantumCrypto() {
        this.cryptoSettings = {
            postQuantumEnabled: true,
            algorithm: 'kyber',
            hybridEnabled: true
        };
        console.log("Постквантовое шифрование инициализировано");
    }

    /**
     * Шифрование данных с использованием гибридного подхода
     */
    async encryptData(data) {
        if (!this.cryptoSettings.postQuantumEnabled) {
            return this.legacyEncrypt(data);
        }

        try {
            const postQuantumEncrypted = this.postQuantumEncrypt(data);
            if (this.cryptoSettings.hybridEnabled) {
                const hybridEncrypted = this.legacyEncrypt(postQuantumEncrypted);
                return hybridEncrypted;
            }
            return postQuantumEncrypted;
        } catch (error) {
            console.error("Ошибка шифрования:", error);
            throw error;
        }
    }

    postQuantumEncrypt(data) {
        console.log("Эмуляция постквантового шифрования...");
        return `post_quantum_encrypted_${data}`;
    }

    legacyEncrypt(data) {
        console.log("Эмуляция классического шифрования...");
        return `aes_encrypted_${data}`;
    }

    /**
     * Инициализация модели машинного обучения
     */
    initAnomalyDetection() {
        this.anomalyModel = {
            trainingData: [],
            threshold: 0.9,
            isTrained: false
        };
        console.log("Модель обнаружения аномалий инициализирована");
    }

    trainAnomalyModel() {
        const events = this.state.defenseHistory.map(action => ({
            threatLevel: action.threatLevel,
            evidenceCount: action.evidenceCount,
            measures: action.measures.length
        }));

        this.anomalyModel.trainingData = events;
        this.anomalyModel.isTrained = true;
        console.log("Модель обучена на основе исторических данных");
    }

    predictAnomaly(event) {
        if (!this.anomalyModel.isTrained) {
            this.trainAnomalyModel();
        }

        const avgThreatLevel = this.anomalyModel.trainingData.reduce((sum, e) => sum + e.threatLevel, 0) / this.anomalyModel.trainingData.length;
        const eventThreatLevel = this.evaluateThreatScore(event);

        const anomalyScore = eventThreatLevel / avgThreatLevel;
        if (anomalyScore > this.anomalyModel.threshold) {
            console.log("Обнаружена аномалия:", event);
            this.activateDefense('anomaly_detected', event);
        }

        return anomalyScore;
    }

