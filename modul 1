     */
    async updateAttackPatterns() {
        const newPatterns = [/new_malicious_pattern/i];
        this.maliciousPatterns = [...this.maliciousPatterns, ...newPatterns];
        console.log("Шаблоны атак обновлены");
    }

    /**
